GIT_CHGLOG_VERSION=v0.15.0
OSXCROSS_VERSION=v26.1.1
DEBIAN_FRONTEND=noninteractive
DPKG_ARCH="amd64 arm64 armel armhf i386 mips mipsel powerpc ppc64el s390x riscv64"
CROSSBUILD_ARCH="amd64 arm64 armel armhf i386 mipsel ppc64el s390x riscv64"
GO111MODULE=on
MUSL_TARGETS="aarch64-linux-musl x86_64-linux-musl arm-linux-musleabihf armv7-linux-musleabihf mips-linux-musl mips64-linux-musl mips64el-linux-musl mipsel-linux-musl s390x-linux-musl riscv64-linux-musl powerpc-linux-musl powerpc64-linux-musl powerpc64le-linux-musl i686-linux-musl loongarch64-linux-musl"
